# Salin ke .env (jangan commit .env berisi token/key asli!)
PORT=3000

# Token bot Telegram dari @BotFather (wajib untuk bot /start)
BOT_TOKEN=

# URL publik WebApp (dipakai tombol di bot). Isi setelah deploy, mis:
# WEBAPP_URL=https://agent-video.example.com/
WEBAPP_URL=http://localhost:3000/

# --- Enkripsi vault API key (PENTING) ---
# Isi SALAH SATU. Bila keduanya kosong, server membuat kunci acak sekali
# di server/data/.encryption-key — backup file itu, bila hilang semua key
# tersimpan tidak bisa dibuka lagi.
# ENCRYPTION_KEY=<64 karakter hex = 32 byte, contoh dari: openssl rand -hex 32>
# ENCRYPTION_PASSPHRASE=<frasa rahasia panjang>

# --- Key default server (opsional, fallback) ---
# Dipakai hanya bila user belum isi key sendiri di Settings.
# Prioritas generate: key user -> key default server -> mock demo.
# RUNWAY_API_KEY=
# KLING_API_KEY=            # format: ACCESS_KEY:SECRET_KEY
# LUMA_API_KEY=
# GOOGLE_API_KEY=           # untuk Veo (Google AI Studio)
# MINIMAX_API_KEY=
# CUSTOM_API_KEY=
# CUSTOM_VIDEO_BASE_URL=    # untuk provider Custom, mis: https://api.contoh.com/v1
# CUSTOM_VIDEO_MODEL=       # mis: video-1

# --- Text AI (Xingchi) — HANYA teks/naskah, BUKAN render video ---
# Key dibaca HANYA dari env ini saat runtime. Inject saat deploy dari Secure
# Vault; JANGAN tulis nilainya di repo, log, atau file mana pun.
# Model yang tersedia: gpt-6-astra, gpt-6.1-sol (text-only, tanpa model video).
# Bila kosong: fitur naskah AI fallback ke template lokal (dilabeli di UI).
# XINGCHI_API_KEY=

# --- APINEX (Text AI + Image AI) — key user via Settings, BUKAN provider video ---
# Key APINEX (sk-apx-...) dibuat user sendiri di apinex.bond/keys dan ditempel
# di Settings; env di bawah hanya fallback server bila user belum isi key.
# Dipakai untuk: Text AI (model FREE: free/gemini-4-hydrogen, free/kimi-k3,
# free/deepseek-v4-pro-0813, free/minimax-m3.1-flash) dan Image AI thumbnail
# (Nano Banana 2 FREE, GPT Image 2.6 Flare $0,05, Seedream 5 $0,02,
# Grok Imagine 2 $0,02 per gambar). APINEX TIDAK BISA bikin video.
# APINEX_API_KEY=
